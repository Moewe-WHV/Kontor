# Kopieren nach .env.prod und ausfuellen.
#   cp .env.prod.example .env.prod
# Danach:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Domain, unter der der Leitstand laufen soll (DNS muss auf die VPS-IP zeigen):
DOMAIN=leitstand.example.com

# E-Mail fuer Let's Encrypt (Ablauf-Warnungen); optional, aber empfohlen:
ACME_EMAIL=du@example.com

# --- Login (schuetzt alle Seiten) ---
APP_USERNAME=admin
# Langes, zufaelliges Passwort:  openssl rand -base64 24
APP_PASSWORD=

# Signiert die NiceGUI-Session-Cookies. Fester Zufallsstring:  openssl rand -hex 32
STORAGE_SECRET=

# --- GitHub-PR-Ansicht (optional) ---
# Fine-grained PAT: "Pull requests: read" + "Issues: read" (+ "Contents: read" bei privatem Repo)
GITHUB_TOKEN=
GITHUB_REPO=zauberzeug/nicegui
