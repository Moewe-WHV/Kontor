# Kopieren nach .env und ausfuellen. docker-compose liest .env automatisch.

# GitHub Personal Access Token (fine-grained, nur "Pull requests: read" + "Issues: read"
# bzw. bei privatem Repo zusaetzlich "Contents: read"). Ohne Token: 60 Requests/Stunde.
GITHUB_TOKEN=

# Default-Repo, das beim Start geladen wird (im UI aenderbar):
GITHUB_REPO=zauberzeug/nicegui

# Signiert die NiceGUI-Storage-Cookies (beliebiger String):
STORAGE_SECRET=kontor-leitstand-dev
